<?xml version="1.0" encoding="UTF-8" ?>
<!-- webapp 专用 FastDDS 配置: 纯 UDP 传输, 不建 /dev/shm 共享内存段。
     原因: mapping/navigation.launch 与 stop_nav.sh 都会清理 /dev/shm/fastrtps_*,
     若 webapp 用 SHM, 其段文件会被误删导致节点收不到任何话题(实测踩坑)。
     子 launch 不继承此配置(app.py 已从子进程环境剔除), 建图导航栈仍用 SHM。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="webapp_udp_only" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
    <data_writer profile_name="dw_default" is_default_profile="true">
        <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
    </data_writer>
    <data_reader profile_name="dr_default" is_default_profile="true">
        <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
    </data_reader>
</profiles>
